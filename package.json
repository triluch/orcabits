{
  "name": "orcabits",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "validate": "node scripts/registry.mjs validate",
    "update-github": "node scripts/update-github.mjs",
    "build": "npm run validate && astro build && pagefind --site dist",
    "dev": "astro dev --host 127.0.0.1",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test-browser": "playwright test",
    "check": "npm run validate && astro check && npm run format-check && npm test",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "dependencies": {
    "astro": "7.4.13",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "pagefind": "1.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
